# API role has NOBYPASSRLS; migrations/bootstrap use the separate admin URL.
DATABASE_URL=postgresql://maxcare_app:maxcare_app_dev_0123456789abcdef0123456789abcdef@localhost:5432/maxcare?schema=public
DIRECT_URL=postgresql://maxcare:maxcare_dev@localhost:5432/maxcare?schema=public
APP_DB_PASSWORD=maxcare_app_dev_0123456789abcdef0123456789abcdef
# Generate a random secret of at least 32 characters for non-development use.
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
PORT=3000
NODE_ENV=development
# Exact browser origin. Comma-separated values are supported; never use *.
WEB_ORIGIN=http://localhost:5173
# Set only when frontend and API share a parent domain in production.
COOKIE_DOMAIN=
LOG_LEVEL=info
# Set to false to disable the CSV patient import endpoints (returns 404).
IMPORTS_ENABLED=true
# Global owner(s) allowed to manage companies. Comma-separated emails.
PLATFORM_OWNER_EMAILS=
